# dealHound configuration (example, versioned).
# The real file is config.env at the project root (gitignored).
# Create it with `/dealhound wizard` in Claude Code, or: cp config.example.env config.env
# Format: shell variables, read by deploy/deploy.sh and dealhound/cli.py.

# Default server: SSH destination, key-based auth (from WSL on Windows).
DEPLOY_HOST="user@192.168.1.10"

# Other servers that may run missions (space-separated), shown by `/dealhound list`.
EXTRA_HOSTS=""

# Install directory on the servers, relative to the remote user's $HOME.
DEPLOY_DIR="dealhound"

# Minutes between two searches on the data sources (collect.py, no inference).
SEARCH_INTERVAL_MIN=30

# Minutes between two analyses by inference (analyze.py, claude -p on the server).
# Only new listings and price drops are analyzed; nothing new = no inference call.
ANALYSIS_INTERVAL_MIN=180

# Model used by the analysis (claude --model). Empty = Claude Code's default model.
# A smaller model (e.g. "sonnet") costs less per analysis.
ANALYSIS_MODEL=""

# Telegram notifications, sent by the analysis on the server.
# The bot token is a secret: it goes in secrets.env (gitignored), never here.
# Chat ids to notify, space-separated (find them with: bash deploy/py.sh -m dealhound.notify discover).
NOTIFY_TELEGRAM_CHAT_IDS=""
# When to notify:
#   top       a newly scored listing enters the top NOTIFY_TOP_N (default)
#   analysis  after every analysis: synthesis + top 5 (verbose; handy to tune scoring)
#   new_deal  every newly scored listing (verbose)
#   off       no notification
# A mission can override it in mission.yaml: notify: {mode: analysis}
NOTIFY_MODE="top"
NOTIFY_TOP_N=10

# Local Python with requirements installed, used for dry-runs before deploying.
LOCAL_PYTHON="$HOME/.venvs/dealhound/bin/python"
