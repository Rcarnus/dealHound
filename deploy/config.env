# Remote deployment target for deploy/deploy.sh.
# Override locally (not versioned) in deploy/config.local.env.

# SSH destination (key-based auth required: BatchMode).
DEPLOY_HOST="rom@192.168.5.225"

# Install directory, relative to the remote user's $HOME.
DEPLOY_DIR="dealhound"

# systemd OnCalendar expressions (a random delay of up to 5 min is added).
COLLECT_ON_CALENDAR="*:0/30"               # every 30 min
ANALYZE_ON_CALENDAR="*-*-* 08,13,19:00"    # 3 times a day (only once analyze.py exists)
